# Copiar a .env y completar valores locales. Nunca subir .env al repositorio.
# Docker Compose lee este archivo para inyectar variables en los contenedores.

# PostgreSQL (servicio "db", red interna de Docker)
POSTGRES_USER=one_touch
POSTGRES_PASSWORD=REEMPLAZAR_VALOR_LOCAL
POSTGRES_DB=one_touch_dev

# URL usada por comandos npm locales. Dentro de Docker Compose se sustituye
# automáticamente por: postgresql://<usuario>:<password>@db:5432/one_touch_dev
DATABASE_URL="postgresql://one_touch:REEMPLAZAR_VALOR_LOCAL@localhost:5432/one_touch_dev?schema=public"

# Better Auth: generar con openssl rand -base64 32 (mínimo 32 caracteres)
BETTER_AUTH_SECRET=REEMPLAZAR_CON_SECRETO_LOCAL_DE_32_CARACTERES
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Solo desarrollo local sobre HTTP dentro de Docker.
# En producción eliminar esta variable o ponerla en true y servir por HTTPS.
AUTH_COOKIES_SECURE=false

# Credencial del usuario local creado por el seed (solo desarrollo)
SEED_USER_EMAIL=admin@one-touch.local
SEED_USER_PASSWORD=REEMPLAZAR_CONTRASENA_LOCAL
SEED_USER_NAME=Administrador
SEED_TENANT_NAME=Ganga Online

# MCP de Stitch (lo usa opencode.json; no es parte de la aplicación)
STITCH_API_KEY=REEMPLAZAR_SI_SE_REQUIERE
