# Copiar a .env y completar valores locales. Nunca subir .env al repositorio.
# Docker Compose lee este archivo para inyectar variables en los contenedores.

# PostgreSQL (servicio "db", red interna de Docker). Se usa solo si DATABASE_URL
# apunta al contenedor local; los datos del volumen local no se borran.
POSTGRES_USER=one_touch
POSTGRES_PASSWORD=REEMPLAZAR_VALOR_LOCAL
POSTGRES_DB=one_touch_dev

# URL de base de datos que Docker Compose inyecta en app, migrate, worker y seed.
# Puede apuntar al contenedor local (db:5432) o a un PostgreSQL remoto como Supabase.
# Para Supabase con pooler agregar &uselibpqcompat=true al final (TLS del adaptador pg).
DATABASE_URL="postgresql://one_touch:REEMPLAZAR_VALOR_LOCAL@localhost:5432/one_touch_dev?schema=public"

# Better Auth: generar con openssl rand -base64 32 (mínimo 32 caracteres)
BETTER_AUTH_SECRET=REEMPLAZAR_CON_SECRETO_LOCAL_DE_32_CARACTERES
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Solo desarrollo local sobre HTTP dentro de Docker.
# En producción eliminar esta variable o ponerla en true y servir por HTTPS.
AUTH_COOKIES_SECURE=false

# Credencial del usuario local creado por el seed (solo desarrollo)
SEED_USER_EMAIL=admin@one-touch.local
SEED_USER_PASSWORD=REEMPLAZAR_CONTRASENA_LOCAL
SEED_USER_NAME=Administrador
SEED_TENANT_NAME=Ganga Online

# MCP de Stitch (lo usa opencode.json; no es parte de la aplicación)
STITCH_API_KEY=REEMPLAZAR_SI_SE_REQUIERE

# Cifrado AES-256-GCM de credenciales de WhatsApp (base64 de 32 bytes).
WHATSAPP_ENCRYPTION_KEY=REEMPLAZAR_CON_CLAVE_LOCAL_BASE64_32_BYTES
# URL p�blica HTTPS del webhook. Vac�o = webhook no configurado (la app sigue funcionando).
WHATSAPP_WEBHOOK_BASE_URL=
WASENDER_API_BASE_URL=https://www.wasenderapi.com
# Token de CUENTA de Wasender (solo servidor). Requerido para crear sesiones desde el panel
# con el flujo de QR. Se obtiene en https://wasenderapi.com/settings/tokens. Nunca se guarda en BD.
WASENDER_PERSONAL_ACCESS_TOKEN=

# Google Drive: almacenamiento de imágenes de producto, comprobantes de pago y
# fotos de la bandeja. Las nuevas cargas se guardan en OneTouch/One-Touch-Ecommerce/.
# Los archivos existentes en el volumen local siguen leyéndose sin migrar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
