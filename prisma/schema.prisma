// One-Touch-Ecommerce — modelo de datos.
// Fase 1: Better Auth + multi-tenant. Fase 2A: catálogo administrativo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantRole {
  OWNER
  OPERATOR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model User {
  id             String              @id @default(cuid())
  name           String
  email          String              @unique
  emailVerified  Boolean             @default(false)
  image          String?
  // Negocio activo. Se valida siempre contra TenantMembership en la capa de datos.
  activeTenantId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  sessions       Session[]
  accounts       Account[]
  memberships    TenantMembership[]

  @@index([activeTenantId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model Tenant {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  // Número E.164 del canal de WhatsApp de este negocio. Solo lo edita OWNER.
  whatsappPhone String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  memberships TenantMembership[]
  categories  Category[]
  products    Product[]
  variants    ProductVariant[]
  images      ProductImage[]

  @@map("tenants")
}

model TenantMembership {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(OPERATOR)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, role])
  @@index([tenantId, role])
  @@map("tenant_memberships")
}

model Category {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model Product {
  id           String          @id @default(cuid())
  tenantId     String
  categoryId   String?
  name         String
  slug         String
  description  String?
  status       ProductStatus   @default(DRAFT)
  storeVisible Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]
  images       ProductImage[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("products")
}

model ProductVariant {
  id            String    @id @default(cuid())
  tenantId      String
  productId     String
  sku           String
  name          String
  price         Decimal   @db.Decimal(12, 2)
  isActive      Boolean   @default(true)
  isDefault     Boolean   @default(false)
  // Campos reservados para el inventario de fases posteriores.
  // No se exponen ni se modifican desde el catálogo de esta fase.
  stockPhysical Int       @default(0)
  stockReserved Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  storageKey String   @unique
  fileName   String
  mimeType   String
  sizeBytes  Int
  position   Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@index([productId, position])
  @@map("product_images")
}
