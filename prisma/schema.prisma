// One-Touch-Ecommerce — modelo de datos.
// Fase 1: Better Auth + multi-tenant. Fase 2A: catálogo administrativo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantRole {
  OWNER
  OPERATOR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FlowScope {
  PRODUCT
  GLOBAL
}

enum FlowBlockType {
  START
  MESSAGE
  DECISION
  GLOBAL_FLOW
  CHECKOUT
  END
}

enum FlowEndMode {
  FINISH
  HANDOFF
  FINISH_AFTER_CONFIRMATION
}

enum OrderOrigin {
  MANUAL
  // CHATBOT se reserva para fases posteriores.
  CHATBOT
}

enum PaymentStatus {
  PENDING
  ADVANCE_PENDING
  VOUCHER_RECEIVED
  ADVANCE_VERIFIED
  PAID
}

enum FulfillmentStatus {
  WAITING_ADVANCE
  READY_TO_PREPARE
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryMode {
  LOCAL
  PICKUP
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  TRANSFER
}

enum MovementReason {
  INITIAL
  RESTOCK
  DAMAGE
  COUNT_CORRECTION
  OTHER
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum OrderEventType {
  CREATED
  VOUCHER_RECEIVED
  ADVANCE_VERIFIED
  PAYMENT_RECORDED
  PREPARATION_STARTED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum WhatsAppProviderKind {
  WASENDER
  // META se registra como proveedor futuro no disponible (sin credenciales ni cliente).
  META
}

enum WhatsAppConnectionStatus {
  NOT_CONFIGURED
  PENDING
  CONNECTED
  CONNECTING
  NEEDS_LINKING
  DISCONNECTED
  ERROR
}

enum ConversationStatus {
  PENDING
  HUMAN
  RESOLVED
}

enum ConversationMode {
  HUMAN
  BOT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageKind {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  STICKER
  LOCATION
  CONTACT
  UNKNOWN
}

enum MessageStatus {
  PENDING
  PROCESSING
  ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
  UNCERTAIN
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum OutboundStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  UNCERTAIN
}

enum ConversationEventType {
  CREATED
  ASSIGNED
  UNASSIGNED
  RESOLVED
  REOPENED
  MODE_CHANGED
  MESSAGE_IN
  MESSAGE_OUT
}

model User {
  id             String              @id @default(cuid())
  name           String
  email          String              @unique
  emailVerified  Boolean             @default(false)
  image          String?
  // Negocio activo. Se valida siempre contra TenantMembership en la capa de datos.
  activeTenantId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  sessions       Session[]
  accounts       Account[]
  memberships    TenantMembership[]

  @@index([activeTenantId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model Tenant {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  // Número E.164 del canal de WhatsApp de este negocio. Solo lo edita OWNER.
  whatsappPhone String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  memberships TenantMembership[]
  categories  Category[]
  products    Product[]
  variants    ProductVariant[]
  images      ProductImage[]
  landings    Landing[]
  landingVersions LandingVersion[]
  flows       SalesFlow[]
  flowVersions SalesFlowVersion[]
  templates   MessageTemplate[]
  templateTypes TemplateType[]
  templateMedia TemplateMedia[]
  orders      Order[]
  orderItems  OrderItem[]
  reservations StockReservation[]
  movements   InventoryMovement[]
  vouchers    PaymentVoucher[]
  orderEvents OrderEvent[]
  whatsappConnections WhatsAppConnection[]
  whatsappContacts     WhatsAppContact[]
  conversations        Conversation[]
  messages             ConversationMessage[]
  conversationEvents   ConversationEvent[]
  webhookEvents        WebhookEvent[]
  outboundMessages     OutboundMessage[]

  @@map("tenants")
}

model TenantMembership {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(OPERATOR)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, role])
  @@index([tenantId, role])
  @@map("tenant_memberships")
}

model Category {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model Product {
  id           String          @id @default(cuid())
  tenantId     String
  categoryId   String?
  name         String
  slug         String
  description  String?
  status       ProductStatus   @default(DRAFT)
  storeVisible Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]
  images       ProductImage[]
  landings     Landing[]
  flows        SalesFlow[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("products")
}

model ProductVariant {
  id            String    @id @default(cuid())
  tenantId      String
  productId     String
  sku           String
  name          String
  price         Decimal   @db.Decimal(12, 2)
  isActive      Boolean   @default(true)
  isDefault     Boolean   @default(false)
  stockPhysical Int       @default(0)
  stockReserved Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements     InventoryMovement[]
  reservations  StockReservation[]
  orderItems    OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  storageKey String   @unique
  fileName   String
  mimeType   String
  sizeBytes  Int
  position   Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  landingVersions LandingVersion[]
  templates       MessageTemplate[]

  @@index([tenantId, productId])
  @@index([productId, position])
  @@map("product_images")
}

/// Una landing por producto y negocio. El borrador y la versión publicada son
/// snapshots independientes para no alterar la página pública mientras se edita.
model Landing {
  id                 String           @id @default(cuid())
  tenantId           String
  productId          String
  slug               String
  draftVersionId     String?
  publishedVersionId String?
  publishedAt        DateTime?
  createdById        String
  updatedById        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  versions           LandingVersion[] @relation("LandingVersions")
  draft              LandingVersion?  @relation("DraftVersion", fields: [draftVersionId], references: [id], onDelete: SetNull)
  published          LandingVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@unique([tenantId, productId])
  @@index([tenantId])
  @@map("landings")
}

/// Snapshot inmutable de contenido. `revision` permite concurrencia optimista.
model LandingVersion {
  id          String   @id @default(cuid())
  tenantId    String
  landingId   String
  version     Int
  headline    String
  summary     String
  heroImageId String?
  benefits    Json
  faqs        Json
  design      Json     @default("{}")
  revision    Int      @default(1)
  createdById String
  createdAt   DateTime @default(now())
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  landing     Landing       @relation("LandingVersions", fields: [landingId], references: [id], onDelete: Cascade)
  heroImage   ProductImage? @relation(fields: [heroImageId], references: [id], onDelete: Restrict)
  draftOf     Landing[]     @relation("DraftVersion")
  publishedOf Landing[]     @relation("PublishedVersion")

  @@unique([landingId, version])
  @@index([tenantId, landingId])
  @@map("landing_versions")
}

/// Tipo de plantilla configurable por negocio. Los tipos predeterminados se
/// crean por tenant; los personalizados los gestiona el usuario en Configuración.
model TemplateType {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("template_types")
}

/// Archivo propio de una plantilla (foto o video), almacenado en Drive.
model TemplateMedia {
  id         String   @id @default(cuid())
  tenantId   String
  storageKey String   @unique
  fileName   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templates  MessageTemplate[]

  @@index([tenantId])
  @@map("template_media")
}

/// Plantilla reutilizable de mensaje. El contenido es texto plano; las variables
/// dinámicas se resolverán en el futuro motor de ejecución.
model MessageTemplate {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  /// Slug del tipo en template_types. Se guarda como texto para admitir tipos creados por el negocio.
  type      String
  content   String
  imageId   String?
  mediaId   String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  image     ProductImage? @relation(fields: [imageId], references: [id], onDelete: Restrict)
  media     TemplateMedia? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([tenantId, type])
  @@map("message_templates")
}

/// Flujo de venta por producto o flujo global reutilizable del negocio.
model SalesFlow {
  id                 String             @id @default(cuid())
  tenantId           String
  productId          String?
  scope              FlowScope          @default(PRODUCT)
  name               String
  slug               String
  description        String?
  draftVersionId     String?
  publishedVersionId String?
  publishedAt        DateTime?
  createdById        String
  updatedById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product            Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  versions           SalesFlowVersion[] @relation("FlowVersions")
  draft              SalesFlowVersion?  @relation("DraftFlowVersion", fields: [draftVersionId], references: [id], onDelete: SetNull)
  published          SalesFlowVersion?  @relation("PublishedFlowVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@unique([tenantId, productId])
  @@index([tenantId, scope])
  @@map("sales_flows")
}

/// Snapshot inmutable de un diagrama. Incluye las plantillas y versiones de
/// flujos globales utilizadas para que publicar nunca dependa de cambios futuros.
model SalesFlowVersion {
  id          String   @id @default(cuid())
  tenantId    String
  flowId      String
  version     Int
  revision    Int      @default(1)
  nodes       Json
  edges       Json
  templates   Json
  globalFlows Json
  createdById String
  createdAt   DateTime @default(now())
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flow        SalesFlow  @relation("FlowVersions", fields: [flowId], references: [id], onDelete: Cascade)
  draftOf     SalesFlow[] @relation("DraftFlowVersion")
  publishedOf SalesFlow[] @relation("PublishedFlowVersion")

  @@unique([flowId, version])
  @@index([tenantId, flowId])
  @@map("sales_flow_versions")
}

/// Secuencia de numeración creada manualmente en la migración de pedidos.
/// Se declara para que Prisma no intente eliminarla.
model OrderNumberSequence {
  tenantId   String @id
  lastNumber Int    @default(0)

  @@map("order_number_sequences")
}

/// Movimiento auditável de inventario. Nunca se elimina, ni si el producto se archiva.
model InventoryMovement {
  id             String          @id @default(cuid())
  tenantId       String
  variantId      String
  delta          Int
  previousPhysical Int
  newPhysical    Int
  reason         MovementReason
  note           String?
  reference      String?
  createdById    String
  createdAt      DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant        ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([tenantId, variantId, createdAt])
  @@map("inventory_movements")
}

/// Pedido comercial. Expone estados de pago y preparación independientes.
model Order {
  id                String             @id @default(cuid())
  tenantId          String
  orderNumber       Int
  origin            OrderOrigin        @default(MANUAL)
  customerName      String
  customerPhone     String
  deliveryMode      DeliveryMode
  deliveryAddress   String?
  shippingCost      Decimal            @default(0) @db.Decimal(12, 2)
  shippingKnown     Boolean            @default(true)
  paymentMethod     PaymentMethod
  requiresAdvance   Boolean            @default(false)
  advanceRequired   Decimal            @default(0) @db.Decimal(12, 2)
  advancePaid       Decimal            @default(0) @db.Decimal(12, 2)
  subtotal          Decimal            @db.Decimal(12, 2)
  total             Decimal            @db.Decimal(12, 2)
  paymentStatus     PaymentStatus      @default(PENDING)
  fulfillmentStatus FulfillmentStatus  @default(READY_TO_PREPARE)
  notes             String?
  idempotencyKey    String?
  confirmedAt       DateTime           @default(now())
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  reservations      StockReservation[]
  vouchers          PaymentVoucher[]
  events            OrderEvent[]
  conversation      Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  conversationId    String?

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, fulfillmentStatus])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, conversationId])
  @@map("orders")
}

/// Línea con snapshot inmutable del producto en el momento de confirmar.
model OrderItem {
  id          String         @id @default(cuid())
  tenantId    String
  orderId     String
  variantId   String
  productName String
  variantName String
  sku         String
  quantity    Int
  unitPrice   Decimal        @db.Decimal(12, 2)
  lineTotal   Decimal        @db.Decimal(12, 2)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([tenantId, orderId])
  @@map("order_items")
}

/// Reserva de stock. Una fila por variante y pedido (se acumula en `quantity`).
model StockReservation {
  id          String             @id @default(cuid())
  tenantId    String
  orderId     String
  variantId   String
  quantity    Int
  status      ReservationStatus  @default(ACTIVE)
  createdAt   DateTime           @default(now())
  releasedAt  DateTime?
  consumedAt  DateTime?
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([tenantId, status])
  @@map("stock_reservations")
}

/// Comprobante privado de adelanto. Nunca se expone públicamente.
model PaymentVoucher {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  storageKey  String   @unique
  fileName    String
  mimeType    String
  sizeBytes   Int
  amountReported Decimal @db.Decimal(12, 2)
  reference   String?
  verified    Boolean  @default(false)
  verifiedAmount Decimal? @db.Decimal(12, 2)
  verifiedById String?
  verifiedAt  DateTime?
  createdById String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("payment_vouchers")
}

/// Historial cronológico de eventos del pedido.
model OrderEvent {
  id          String         @id @default(cuid())
  tenantId    String
  orderId     String
  type        OrderEventType
  description String
  amount      Decimal?       @db.Decimal(12, 2)
  createdById String
  createdAt   DateTime       @default(now())
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId, createdAt])
  @@map("order_events")
}

/// Conexión de WhatsApp por negocio. Las credenciales se guardan cifradas.
model WhatsAppConnection {
  id                 String                    @id @default(cuid())
  tenantId           String
  provider           WhatsAppProviderKind
  name               String
  expectedPhone      String?
  verifiedPhone      String?
  externalSessionId  String?                   @unique
  status             WhatsAppConnectionStatus  @default(NOT_CONFIGURED)
  providerStatus     String?
  isPrimary          Boolean                   @default(false)
  credentials        String
  credentialsVersion Int                       @default(1)
  webhookId          String                    @unique
  webhookSecretHash  String?
  lastCheckedAt      DateTime?
  lastError          String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts           WhatsAppContact[]
  conversations      Conversation[]
  messages           ConversationMessage[]
  webhookEvents      WebhookEvent[]
  outboundMessages   OutboundMessage[]

  @@unique([tenantId, name])
  @@index([tenantId, isPrimary])
  @@map("whatsapp_connections")
}

/// Contacto identificado dentro de una conexión. Conserva PN y LID sin convertirlos.
model WhatsAppContact {
  id             String                 @id @default(cuid())
  tenantId       String
  connectionId   String
  externalId     String
  phone          String?
  lid            String?
  addressingMode String?
  displayName    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection     WhatsAppConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  conversations  Conversation[]

  @@unique([connectionId, externalId])
  @@index([tenantId, phone])
  @@map("whatsapp_contacts")
}

model Conversation {
  id              String                 @id @default(cuid())
  tenantId        String
  connectionId    String
  contactId       String
  status          ConversationStatus     @default(PENDING)
  mode            ConversationMode       @default(HUMAN)
  assignedToId    String?
  lastMessageAt   DateTime               @default(now())
  lastMessage     String?
  unreadCount     Int                    @default(0)
  context         Json                   @default("{}")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection      WhatsAppConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  contact         WhatsAppContact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages        ConversationMessage[]
  events          ConversationEvent[]
  outbound        OutboundMessage[]
  orders          Order[]

  @@unique([connectionId, contactId])
  @@index([tenantId, status, lastMessageAt])
  @@map("conversations")
}

model ConversationMessage {
  id              String                 @id @default(cuid())
  tenantId        String
  connectionId    String
  conversationId  String
  externalId      String?
  direction       MessageDirection
  kind            MessageKind            @default(TEXT)
  authorName      String?
  content         String?
  media           Json                   @default("{}")
  status          MessageStatus          @default(PENDING)
  providerStatus  String?
  eventAt         DateTime?
  createdAt       DateTime               @default(now())
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection      WhatsAppConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  conversation    Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  outbound        OutboundMessage?

  @@unique([connectionId, externalId])
  @@index([tenantId, conversationId, createdAt])
  @@map("conversation_messages")
}

model ConversationEvent {
  id             String                 @id @default(cuid())
  tenantId       String
  conversationId String
  type           ConversationEventType
  description    String
  actorId        String?
  createdAt      DateTime               @default(now())
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
  @@map("conversation_events")
}

/// Evento durable recibido del proveedor. Nunca se guarda el payload crudo
/// completo porque puede contener sessionId/API keys.
model WebhookEvent {
  id             String               @id @default(cuid())
  tenantId       String?
  connectionId   String?
  provider       WhatsAppProviderKind
  event          String
  dedupeKey      String               @unique
  payload        Json
  status         WebhookEventStatus   @default(RECEIVED)
  error          String?
  createdAt      DateTime             @default(now())
  processedAt    DateTime?
  tenant         Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  connection     WhatsAppConnection?  @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("webhook_events")
}

/// Cola persistente de mensajes salientes; el worker la procesa con concurrencia limitada.
model OutboundMessage {
  id                   String               @id @default(cuid())
  tenantId             String
  connectionId         String
  conversationId       String
  conversationMessageId String              @unique
  to                   String
  text                 String
  kind                 MessageKind          @default(TEXT)
  mediaUrl             String?
  status               OutboundStatus       @default(PENDING)
  attempts             Int                  @default(0)
  lastError            String?
  providerMessageId    String?
  nextAttemptAt        DateTime             @default(now())
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection           WhatsAppConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  conversation         Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message              ConversationMessage  @relation(fields: [conversationMessageId], references: [id], onDelete: Cascade)

  @@unique([connectionId, providerMessageId])
  @@index([status, nextAttemptAt])
  @@map("outbound_messages")
}
